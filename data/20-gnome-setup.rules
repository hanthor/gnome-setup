 // -*- mode: js; js-indent-level: 4; indent-tabs-mode: nil -*-
 //
 // DO NOT EDIT THIS FILE, it will be overwritten on update.
 //
 // Allow the gnome-inital-setup user to do certain actions without
 // being interrupted by password dialogs

polkit.addRule(function(action, subject) {
    var is_live = false;
    try {
        polkit.spawn(["/usr/bin/cat", "/run/gnomeos/is-live"]);
        is_live = true;
     } catch (error) {}

     if (!(subject.isInGroup('gnome-initial-setup') || is_live))
         return undefined;
     if (subject.active == false || subject.local == false)
        return undefined;

    if (action.id == "io.systemd.sysinstall.Run" ||
        action.id == "io.systemd.sysinstall.ListCandidateDevices" ||
        action.id == "io.systemd.cryptenroll.enroll") {
        return polkit.Result.YES;
    }
});
