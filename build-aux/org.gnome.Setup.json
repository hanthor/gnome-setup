{
    "id" : "org.gnome.Setup",
    "runtime" : "org.gnome.Sdk",
    "runtime-version" : "master",
    "sdk" : "org.gnome.Sdk",
    "sdk-extensions" : [
        "org.gnome.Sdk.Debug",
    	"org.gnome.Sdk.Locale",
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command" : "gnome-setup",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=system-bus",
        "--device=dri",
        "--socket=wayland"
    ],
    "build-options" : {
        "append-path" : "/usr/lib/sdk/rust-stable/bin",
        "build-args" : [
            "--share=network"
        ],
        "env" : {
            "RUST_BACKTRACE" : "1",
            "RUST_LOG" : "setup=debug"
        }
    },
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
	{
	  "name": "gnome-desktop",
	  "buildsystem": "meson",
	  "sources": [
	    {
	      "type": "git",
	      "url": "https://gitlab.gnome.org/GNOME/gnome-desktop.git",
	      "branch": "master"
	    }
	  ]
	},
	{
            "name" : "demo-content",
            "buildsystem" : "simple",
            "sources" : [
            	{
            	    "type" : "dir",
            	    "path" : "."
            	}
            ],
            "build-commands" : [
            	"install -Dm644 demo-eula.xml /app/share/gnome-setup/eula.xml"
            ]
        },
        {
            "name" : "setup",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "path" : "."
                }
            ],
            "post-install": ["ls /app/share/gnome-setup"]
        }
    ]
}
