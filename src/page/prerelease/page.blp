using Gtk 4.0;
using Adw 1;

template $SetupPrereleasePage : $SetupBasePage {
  title: _("Disclaimer");

  ready: true;
  next => $next() swapped;

  child: Adw.StatusPage status {

    child: Gtk.ListBox {
      accessible-role: generic; // Not really a list...
      selection-mode: none;
      visible: bind experiment.visible;

      Adw.ActionRow experiment {
        title: _("Experimental Feature(s)");
        use-markup: false;
        visible: false;
        styles [ "property" ]
      }

      styles [ "boxed-list" ]
    };

    // TODO: This role is technically wrong (this isn't an alert), but it's
    // the only way I could get the screen reader to read this...
    accessible-role: alert;
  };
}