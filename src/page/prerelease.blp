using Gtk 4.0;
using Adw 1;

template $SetupPrereleasePage : $SetupBasePage {
  title: _("Disclaimer");

  ready: true;
  next => $next() swapped;

  child: Adw.Clamp {
    maximum-size: 520;
    Adw.StatusPage status {
      icon-name: "dialog-warning-symbolic";
      title: _("Pre-release Software");
      styles ["disclaimer"]

      // TODO: This role is technically wrong (this isn't an alert), but it's
      // the only way I could get the screen reader to read this...
      accessible-role: alert;
    }
  };
}