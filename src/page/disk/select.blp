using Gtk 4.0;
using Adw 1;

template $SetupDiskSelectPage : $SetupBasePage {
  title: _("Disk Selection");

  ready: true;
  next => $confirm() swapped;

  child: Adw.StatusPage {
    title: _("Select A Disk");
    description: _("Select the disk to install the operating system to. <b>Make sure any important documents and files have been backed up.</b>");

    Gtk.Box {
      orientation: vertical;
      spacing: 12;

      Gtk.ListBox disks {
        Adw.ActionRow {
          [prefix]
          Gtk.CheckButton radio-1 {}

          activatable-widget: radio-1;
          title: "Sandmug SSD 960 1TB";
          subtitle: "128 GB Used / 768 GB Free";
        }
        Adw.ActionRow {
          [prefix]
          Gtk.CheckButton radio-3 {
            group: radio-1;
          }

          activatable-widget: radio-3;
          title: "Sandmug SSD 960 1TB";
          subtitle: "Empty / 1.0 TB Free";
        }
        Adw.ActionRow {
          [prefix]
          Gtk.CheckButton radio-2 {
            group: radio-1;
          }

          activatable-widget: radio-2;
          title: "OceanDoor Sharkfin HDD 4TB";
          subtitle: "4.0 TB Used / Full";
        }
        Adw.ActionRow {
          [prefix]
          Gtk.CheckButton radio-4 {
            group: radio-1;
          }

          activatable-widget: radio-4;
          title: "GrainyWind MP700 NVME 2TB";
          subtitle: "1.99 TB Used / 10 GB Free";
        }

        styles [ "boxed-list" ]
      }

      Gtk.Label {
        label: _("Setup will scan the selected disk and offer partitioning options.");
        wrap: true;
        justify: center;
        styles [ "dim-label" ]
      }

    }
  };
}