using Gtk 4.0;
using Adw 1;

template $SetupEulaPage : $SetupBasePage {
  title: _("Terms of Use");
  big-title: true;

  ready: bind accept.active;
  next => $next() swapped;


  child: Gtk.Box eula {
    spacing: 18;
    margin-bottom: 12;
    orientation: vertical;
    styles [ "card" ]
  };

  bottom-child: Gtk.CheckButton accept {
      label: _("I have read and accept the Terms of Use");
      halign: center;
      receives-default: true;
    };
}