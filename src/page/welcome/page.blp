using Gtk 4.0;
using Adw 1;

template $SetupWelcomePage : $SetupBasePage {
  can-next: false;
  title: bind $in_session(_("Welcome"), _("Try or Install?")) as <string>;

  child: Adw.StatusPage info {
    title: bind $apply_osinfo(_("Welcome {os_name}")) as <string>;
    description: bind $in_session(_("You can start an installation while you continue testing {os_name}"),
                                  _("You can try {os_name} in a temporary environment before you install, or you can start an installation right away."))
                                  as <string>;
    Gtk.Box {
      spacing: 12;
      halign: center;

      Gtk.Button try_btn {
        use-underline: true;
        clicked => $on_try() swapped;
        label: bind $apply_osinfo(_("_Try {os_name}")) as <string>;

        styles [ "pill" ]

        accessibility {
          // TODO: If we get a better role above, probably drop this?
          description: _("Try out the operating system in a temporary environment before you install");
        }
      }

      Gtk.Button install_btn {
        label: _("_Install Now");
        use-underline: true;
        clicked => $on_install() swapped;
        styles [ "pill", "suggested-action" ]
      }
    }

    styles [ "larger-art", "icon-dropshadow" ]
  };
}

Gtk.SizeGroup {
  widgets [ try_btn, install_btn ]
}