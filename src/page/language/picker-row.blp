using Gtk 4.0;
using Adw 1;

template $SetupLanguagePickerRow : Gtk.ListBoxRow {
  Gtk.Box {
    spacing: 6;
    valign: center;
    styles ["header"]

    Gtk.Box {
      orientation: vertical;
      styles ["title"]

      Gtk.Label title {
        xalign: 0;
        styles ["title"]
      }

      Gtk.Label subtitle {
        xalign: 0;
        styles ["subtitle"]
      }
    }

    Gtk.Image {
      icon-name: "object-select-symbolic";
      styles ["accent", "check"]
    }

  }
}