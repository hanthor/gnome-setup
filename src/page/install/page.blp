using Gtk 4.0;
using Adw 1;

template $SetupInstallPage : $SetupBasePage {
  can-pop: false;
  can-next: false;
  can-close: false;

  child: Adw.StatusPage info {
    Gtk.Box {
      orientation: vertical;
      spacing: 6;

      Gtk.ProgressBar progress {}

      Gtk.Box {
        orientation: horizontal;
        spacing: 6;

        Gtk.Spinner {
          spinning: true;
        }

        Gtk.Label status {
          halign: start;
          styles [ "dim-label" ]
        }
      }
    }

    styles [ "larger-art", "icon-dropshadow" ]
  };
}