using Gtk 4.0;

template $SetupKeyboardPickerRow : Gtk.ListBoxRow {
  Gtk.Box {
    spacing: 6;
    valign: center;
    styles ["header"]

    Gtk.Label title {
      xalign: 0;
      styles ["title"]
    }

    Gtk.Image {
      icon-name: "object-select-symbolic";
      styles ["accent", "check"]
    }

  }
}