using Gtk 4.0;
using Adw 1;

template $SetupRecoveryKeyPage : $SetupBasePage {
  title: _("Done");

  can-next: false;
  can-pop: false;

  child: Adw.StatusPage {
    title: _("Back Up Recovery Key");
    description: _("Write down or save this secret recovery key to a secure location, such as on paper in your safe or in a password manager.");

    icon-name: "recovery-key-symbolic";

    Gtk.Box {
      spacing: 12;
      orientation: vertical;

      Gtk.Box {
            spacing: 12;
            Gtk.Label recovery_key_label {
                selectable: true;
                wrap: true;
                lines: 2;
                accessibility {
                    label: _("Recovery Key");
                }
            }
            styles [ "card" ]
          }

      Gtk.Box qr_code_box {
        orientation: vertical;
        spacing: 6;
        halign: center;
        visible: false;

        Gtk.Picture qr_code_picture {
          halign: center;
          width-request: 200;
          height-request: 200;
          accessibility {
            label: _("Recovery Key QR Code");
          }
        }

        Gtk.Label {
          label: _("Scan this code with your phone to store the key in a password manager.");
          wrap: true;
          justify: center;
          styles [ "dim-label" ]
        }
      }

      Gtk.Box {
        spacing: 12;
        halign: center;
        homogeneous: true;

        Gtk.Button copy_btn {
          label: _("_Copy");
          use-underline: true;
          sensitive: false;
          tooltip-text: _("Copy the recovery key to the clipboard");
          clicked => $copy_recovery_key() swapped;
        }

        Gtk.Button save_btn {
          label: _("_Save to File…");
          use-underline: true;
          sensitive: false;
          tooltip-text: _("Save the recovery key to a text file, for example on a USB drive");
          clicked => $save_recovery_key() swapped;
        }
      }

      Gtk.Label error_label {
        visible: false;
        wrap: true;
        styles [ "error" ]
      }

      Gtk.CheckButton confirm_btn {
            label: _("I backed up my recovery key");
            sensitive: false;
      }

      Gtk.Button done_btn {
        label: _("_Done");
        halign: center;
        use-underline: true;
        clicked => $on_done() swapped;
        sensitive: bind confirm_btn.active;
        styles [ "pill", "suggested-action" ]
      }
    }
  };
}