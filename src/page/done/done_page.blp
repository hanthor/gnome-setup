using Gtk 4.0;
using Adw 1;

template $SetupInstallDonePage : $SetupBasePage {
  title: _("Done");

  can-next: false;
  can-pop: false;

  child: Adw.StatusPage info {
    title: _("Installation Complete!");
    description: bind $in_session(_("{os_name} has been installed to this device. Reboot now to start using {os_name} or continue to test in this evaluation environment."),
                                  _("{os_name} has been installed to this device. Reboot now to start using {os_name}"))
                                        as <string>;
    icon-name: "ready-to-go";

    Gtk.Box {
      spacing: 12;
      halign: center;

      Gtk.Button cancel_btn {
        visible: bind $in_session(true, false) as <bool>;
        label: _("_Not Now");
        use-underline: true;
        action-name: "window.close";
        styles [ "pill" ]
      }

      Gtk.Button reboot_btn {
        label: _("_Reboot");
        use-underline: true;
        clicked => $on_reboot() swapped;
        styles [ "pill", "suggested-action" ]
      }
    }

    styles [ "larger-art" ]
  };
}

Gtk.SizeGroup {
  widgets [ cancel_btn, reboot_btn ]
}