using Gtk 4.0;
using Adw 1;

template $SetupBasePage : Adw.NavigationPage {
  accessible-role: tab_panel;

  Adw.BreakpointBin {
    width-request: 360;
    height-request: 294;

    child: Gtk.Overlay {
      [overlay]
      Adw.Bin back {
        halign: start;
        valign: center;
        margin-start: 18;

        Gtk.Button back_btn {
          icon-name: "go-previous-symbolic";

          action-name: "navigation.pop";
          receives-default: false;
          visible: bind template.can-pop;

          accessibility {
            label: _("Back");
          }

          styles ["circular", "nav"]
        }
      }

      Adw.ToolbarView toolbarview {
        notify::top-bar-height => $toolbar_height_changed() swapped;

        [top]
        Adw.HeaderBar headerbar {
          show-title: false;
          show-back-button: bind back.visible inverted;
        }

        Gtk.ScrolledWindow {
          propagate-natural-width: true;
          propagate-natural-height: true;
          hscrollbar-policy: never;
          Gtk.Viewport  viewport {
            vscroll-policy: natural;

            Gtk.Box {
              orientation: vertical;
              valign: center;

              Gtk.Label {
                label: bind template.title;
                margin-bottom: bind toolbarview.top-bar-height;
                visible: bind template.big-title;
                styles [ "title-1" ]
              }

              Adw.Bin contents {}
            }
          }
        }

        [bottom]
        Adw.Bin bottom_contents {
          visible: false;
          styles [ "bottom-bar-padded" ]
        }

        [bottom]
        Adw.Bin mobile_next {
          visible: false;
          Adw.Bin {
            visible: bind template.can-next;

            Gtk.Button mobile_next_btn {
              halign: center;
              use-underline: true;
              sensitive: bind template.ready;

              clicked => $on_next() swapped;

              styles [ "pill", "suggested-action" ]
            }

            styles [ "bottom-bar-padded" ]
          }
        }
      }

      [overlay]
      Adw.Bin next {
        halign: end;
        margin-end: 18;
        valign: center;

        Gtk.Button next_btn {
          icon-name: "go-next-symbolic";
          tooltip-text: _("Next");

          visible: bind template.can_next;
          sensitive: bind template.ready;

          accessibility {
            label: _("Next");
          }

          clicked => $on_next() swapped;

          styles ["circular", "nav", "suggested-action"]
        }
      }
    };

    Adw.Breakpoint breakpoint {
      condition ('max-width: 500sp')
      setters {
        next.visible: false;
        back.visible: false;
        mobile_next.visible: true;
      }
    }

  }
}
