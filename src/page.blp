using Gtk 4.0;
using Adw 1;

template $SetupBasePage : Adw.NavigationPage {

  accessible-role: tab_panel;

  Adw.BreakpointBin {
    width-request: 360;
    height-request: 294;

    child: Gtk.Overlay {
      [overlay]
      Adw.Bin back {
        halign: start;
        valign: center;
        margin-start: 18;

        Gtk.Button {
          icon-name: "go-previous-symbolic";
          tooltip-text: _("Back");

          action-name: "navigation.pop";
          receives-default: false;
          visible: bind template.can-pop;

          accessibility {
            label: _("Back");
          }

          styles ["circular", "nav"]
        }
      }

      Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          show-title: false;
          show-back-button: bind back.visible inverted;
        }

        Adw.Bin contents {}

        [bottom]
        Adw.Bin mobile-next {
          visible: false;
          Gtk.Button {
            label: _("_Next");
            use-underline: true;

            halign: center;
            margin-top: 12;
            margin-bottom: 12;

            visible: bind template.can-next;
            sensitive: bind template.ready;

            clicked => $on_next() swapped;

            styles [ "pill", "suggested-action" ]
          }
        }
      }

      [overlay]
      Adw.Bin next {
        halign: end;
        margin-end: 18;
        valign: center;

        Gtk.Button {
          icon-name: "go-next-symbolic";
          tooltip-text: _("Next");

          visible: bind template.can_next;
          sensitive: bind template.ready;

          accessibility {
            label: _("Next");
          }

          clicked => $on_next() swapped;

          styles ["circular", "nav", "suggested-action"]
        }
      }
    };

    Adw.Breakpoint breakpoint {
      condition ('max-width: 500sp')
      setters {
        next.visible: false;
        back.visible: false;
        mobile-next.visible: true;
      }
    }

  }
}